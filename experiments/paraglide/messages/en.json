{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_title": "Paraglide Playground",
  "language_label": "Language",
  "basic_message_heading": "Basic message",
  "hello_world": "Hello, world!",
  "interpolation_heading": "Interpolation",
  "greeting": "Hello, {name}!",
  "pluralization_heading": "Pluralization",
  "inbox_message_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "You have {count} message.",
        "countPlural=other": "You have {count} messages."
      }
    }
  ],
  "formatting_heading": "Locale-aware formatting",
  "today_is": [
    {
      "declarations": [
        "input today",
        "local formattedToday = today: datetime dateStyle=long"
      ],
      "match": {
        "today=*": "Today is {formattedToday}."
      }
    }
  ],
  "generated_code_heading": "Generated, typed message functions",
  "generated_code_body": "Every key above is a real TypeScript function exported from src/paraglide/messages.js, compiled from messages/en.json and messages/fa.json by the Paraglide compiler."
}
